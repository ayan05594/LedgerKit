# Migration and maintenance commands only. The deployed application reads and
# writes through Supabase's HTTPS Data API, so Vercel does not need this value.
# Prefer the direct or session-pooler URI on port 5432 for migration commands.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth. Vercel's Supabase integration may create equivalent aliases.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
REGISTRATION_SECRET=choose-a-private-registration-secret
